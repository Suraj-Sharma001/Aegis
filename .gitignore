# ── Dependencies ────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / secrets ───────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Build output ─────────────────────────────────────
dist/
build/
.next/
out/

# ── Prisma ────────────────────────────────────────────
# Generated client — regenerated via `npx prisma generate`, don't commit it
backend/node_modules/.prisma/
backend/generated/

# ── Python / embedding service ──────────────────────
embedding-service/venv/
embedding-service/__pycache__/
embedding-service/**/__pycache__/
*.pyc

# ── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS files ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── Docker ────────────────────────────────────────────
# (compose file itself IS committed — this just ignores volume mount dirs if any get created locally)

# ── Misc ──────────────────────────────────────────────
*.zip
.cache/
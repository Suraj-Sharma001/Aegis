# ── Server ──────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql://aegis:aegis_password@localhost:5432/aegis_db?schema=public"

# ── Redis (cache + rate limiting) ──────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ────────────────────────────────────────────
JWT_SECRET="place_your_secret_here"
JWT_EXPIRES_IN="7d"

# ── AI Provider Keys (add the ones you'll actually test with) ──
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Ollama runs locally, no key needed
OLLAMA_BASE_URL="http://localhost:11434"

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
